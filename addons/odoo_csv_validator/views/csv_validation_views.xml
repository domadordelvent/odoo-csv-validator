<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="csv_validation_form" model="ir.ui.view">
        <field name="name">csv.validation.wizard.form</field>
        <field name="model">csv.validation.wizard</field>
        <field name="arch" type="xml">
            <form string="CSV Validator">
                <header>
                    <button name="action_validate" string="Validate CSV" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,valid,errors,incomplete"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1>CSV Validator</h1><p class="text-muted">Check your file structure before importing.</p></div>
                    <div class="alert alert-info" role="alert">Upload a CSV, choose its encoding and separator, then validate. Maximum: 10 MiB and 100,000 data records. The original file is never changed.</div>
                    <group>
                        <group string="1. Upload your file">
                            <field name="filename" invisible="1"/>
                            <field name="file_data" filename="filename"/>
                        </group>
                        <group string="2. Choose the format">
                            <field name="encoding"/>
                            <field name="delimiter"/>
                            <field name="profile_id" groups="odoo_csv_validator.group_validation_profiles" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="alert alert-success" role="alert" invisible="state != 'valid' or applied_profile_name">The CSV structure is valid. Field values have not been checked against Odoo models.</div>
                    <div class="alert alert-success" role="alert" invisible="state != 'valid' or not applied_profile_name">The CSV passes structural checks and the configured column rules.</div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'errors'">Validation issues were found. Review the details below.</div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'incomplete'">Analysis is incomplete. The record count is partial; review the blocking issue.</div>
                    <group string="3. Results" invisible="state == 'draft'">
                        <field name="applied_profile_name" invisible="not applied_profile_name"/>
                        <group><field name="record_count"/><field name="blank_line_count"/></group>
                        <group><field name="issue_count"/><field name="report_filename" invisible="1"/><field name="report_data" filename="report_filename" string="Download CSV report"/></group>
                    </group>
                    <field name="details_truncated" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not details_truncated">Only the first 1,000 issues are shown and exported. The total issue count includes all detected issues.</div>
                    <field name="issue_ids" nolabel="1" invisible="state == 'draft'">
                        <list create="0" edit="0" delete="0">
                            <field name="issue_type" width="120px" widget="badge" decoration-info="issue_type == 'structure'" decoration-warning="issue_type == 'content'"/>
                            <field name="line" width="80px"/><field name="end_line" optional="hide"/>
                            <field name="column_label" width="280px" class="text-wrap text-break"/>
                            <field name="user_message" width="460px"/>
                            <field name="restriction_details" optional="hide"/>
                            <field name="code" optional="hide"/>
                            <field name="column" optional="hide"/>
                            <field name="column_name" optional="hide"/>
                            <field name="message" string="Technical details" optional="hide"/>
                            <field name="first_line" optional="hide"/>
                        </list>
                        <form string="Validation issue" create="0" edit="0" delete="0">
                            <group>
                                <field name="issue_type" widget="badge" decoration-info="issue_type == 'structure'" decoration-warning="issue_type == 'content'"/>
                                <field name="line"/><field name="end_line"/>
                                <field name="column_label"/>
                                <field name="user_message"/>
                                <field name="restriction_details" invisible="not restriction_details"/>
                                <field name="first_line" invisible="not first_line"/>
                            </group>
                            <group string="Technical details"><field name="code"/><field name="message"/></group>
                        </form>
                    </field>
                    <p class="text-muted">Line numbers refer to physical lines, including the header. Multiline records show their start and end lines. Results are temporary.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="csv_validation_action" model="ir.actions.act_window">
        <field name="name">CSV Validator</field>
        <field name="res_model">csv.validation.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="csv_validation_form"/>
        <field name="target">current</field>
    </record>
    <menuitem id="csv_validation_menu" name="CSV Validator" action="csv_validation_action" groups="base.group_user" sequence="90"/>
    <menuitem id="csv_validate_file_menu" name="Validate CSV" parent="csv_validation_menu" action="csv_validation_action" groups="base.group_user" sequence="10"/>
</odoo>
